# ---------------------------------------------------------------------------
# Lebanon Hockey - environment
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# Stripe. Use the NEW key you rolled after the old sk_live_... was rotated.
# Test keys start sk_test_ / pk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen --forward-to localhost:5174/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_chars

# Public base URL - used to build Stripe success/cancel redirects.
APP_URL=http://127.0.0.1:5174

# This email is promoted to the admin role automatically when it registers.
ADMIN_EMAIL=you@example.com

# Store settings
CURRENCY=cad
SHIPPING_FLAT_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000
TAX_RATE=0

PORT=5174
NODE_ENV=development

# Dev only: lets scripts/smoke-test.mjs settle an order without the Stripe CLI.
# Never set this in production - the route 404s when NODE_ENV=production.
ALLOW_DEV_CHECKOUT=false
