# ---------------------------------------------------------------------------
# Lebanon Hockey - environment
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# Stripe. Use the NEW key you rolled after the old sk_live_... was rotated.
# Test keys start sk_test_ / pk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen --forward-to localhost:5174/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_chars

# Public base URL - used to build Stripe success/cancel redirects.
APP_URL=http://127.0.0.1:5174

# This email is promoted to the admin role automatically when it registers.
ADMIN_EMAIL=you@example.com

# Store settings
CURRENCY=cad
SHIPPING_FLAT_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000
TAX_RATE=0

PORT=5174
NODE_ENV=development

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Used for order confirmations, the admin new-order notification, password
# resets, and contact-form notifications.
#
# Leave SMTP_HOST blank and every message is printed to the console and
# recorded in the email_log table instead of being delivered. Nothing breaks;
# the flows stay fully testable without a mail account.
#
# Works with any SMTP provider. Examples:
#   SendGrid  host smtp.sendgrid.net   port 587  user "apikey"  pass <API key>
#   Mailgun   host smtp.mailgun.org    port 587
#   Postmark  host smtp.postmarkapp.com port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true only on port 465 (implicit TLS); 587 uses STARTTLS.
SMTP_SECURE=

# The From address on every message. Must be a domain you are allowed to send as.
MAIL_FROM="Lebanon Hockey <info@lebanonhockey.com>"

# Where new-order and contact-form notifications go. Falls back to ADMIN_EMAIL.
MAIL_ADMIN=info@lebanonhockey.com

# Dev only: lets scripts/smoke-test.mjs settle an order without the Stripe CLI.
# Never set this in production - the route 404s when NODE_ENV=production.
ALLOW_DEV_CHECKOUT=false
