{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hockeydb;Username=postgres;Password=__SET_IN_USER_SECRETS__"
  },

  "Jwt": {
    "Issuer": "HockeyApi",
    "Audience": "HockeyFrontEnd",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5175" ]
  },

  "RateLimit": {
    "AuthAttempts": 5,
    "AuthWindowMinutes": 15
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
